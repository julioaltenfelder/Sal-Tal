# Banco de dados. Em desenvolvimento use SQLite (arquivo).
# Em produção, troque para Postgres: DATABASE_URL="postgresql://usuario:senha@host:5432/banco"
DATABASE_URL="file:./dev.db"

# Segredo para assinar a sessão do admin. Gere um valor aleatório longo.
# Ex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-aleatorio-longo"

TZ="America/Sao_Paulo"
